{
  "name": "quant-roadmap-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run --config config/nodejs/vitest.config.ts",
    "test:watch": "vitest --config config/nodejs/vitest.config.ts",
    "test:coverage": "vitest run --config config/nodejs/vitest.config.ts --coverage",
    "typecheck": "tsc --project config/nodejs/tsconfig.json --noEmit",
    "lint": "eslint --config config/nodejs/eslint.config.mjs 'P*/**/nodejs/*.ts' 'config/nodejs/tests/*.ts' 'config/nodejs/vitest.config.ts'",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write 'P*/**/nodejs/*.ts'",
    "format:check": "prettier --check 'P*/**/nodejs/*.ts'",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "3.2.7"
  }
}
