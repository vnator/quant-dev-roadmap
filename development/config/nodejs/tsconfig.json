{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "types": ["node", "vitest/globals"],
    "skipLibCheck": true
  },
  "include": ["../../P*/*/*/nodejs/*.ts", "*.ts", "tests/*.ts"],
  "exclude": ["node_modules", "coverage"]
}
