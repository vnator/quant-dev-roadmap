# Shared editor configuration
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# C
[*.{c,h}]
indent_size = 4

# Rust
[*.rs]
indent_size = 4

# TypeScript / JavaScript
[*.{ts,tsx,js,mjs,cjs,json,jsonc}]
indent_size = 2

# Markdown
[*.md]
indent_size = 2
trim_trailing_whitespace = false

# YAML
[*.{yaml,yml}]
indent_size = 2

# Makefiles require tabs
[{Makefile,*.mk}]
indent_style = tab
indent_size = 4

# Shell scripts
[*.{sh,bash}]
indent_size = 2

# TOML
[*.toml]
indent_size = 2
